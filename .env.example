# ==============================================================================
# SGAOB — Sistema de Gestión de Árbitros y Oficiales de Básquetbol
# Archivo de variables de entorno de ejemplo (.env.example)
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
# Formato: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sgaob_db?schema=public

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Autenticación (AUTH_PROVIDER: cognito | azure | local)
AUTH_PROVIDER=cognito

# AWS Cognito (AWS Academy Learner Lab - us-east-1)
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_example
COGNITO_CLIENT_ID=your-cognito-app-client-id
COGNITO_JWKS_URI=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_example/.well-known/jwks.json

# Microsoft Entra External ID (Alternativa)
AZURE_TENANT_ID=your-tenant-id-or-name.onmicrosoft.com
AZURE_CLIENT_ID=your-client-id-uuid
AZURE_CLIENT_SECRET=your-client-secret-if-required
AZURE_ISSUER_URL=https://your-tenant-name.ciamlogin.com/your-tenant-id/v2.0
AZURE_JWKS_URI=https://your-tenant-name.ciamlogin.com/your-tenant-id/discovery/v2.0/keys
AZURE_AUDIENCE=api://your-api-client-id

# JWT Local / Secret (para pruebas de desarrollo offline)
JWT_SECRET=super_secret_jwt_key_for_local_dev_testing

# Mailer (Mailpit en desarrollo local, o SMTP / AWS SES / SendGrid)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SGAOB <no-reply@sgaob.cl>"

# Integraciones de Terceros (NBN23 / Swish)
SYNC_PROVIDER=mock
NBN23_API_URL=https://api.nbn23.com/v1
NBN23_API_KEY=mock-nbn23-key
SWISH_API_URL=https://api.swish.basketball/v1
SWISH_API_KEY=mock-swish-key
ENCRYPTION_SECRET=32_bytes_hex_random_key_for_encrypting_secrets

# Rate Limiting (Throttler)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

