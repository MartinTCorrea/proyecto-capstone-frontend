# ==============================================================================
# SGAOB Frontend Web — Variables de Entorno de Ejemplo (Vercel / Local)
# ==============================================================================

# URL base de la API
# En desarrollo local: http://localhost:3000/api o vacio (usa proxy de Vite /api)
# En producción (Vercel): URL pública del Amazon API Gateway en AWS
VITE_API_URL=https://<api-id>.execute-api.us-east-1.amazonaws.com/api

# Proveedor de Autenticación ('cognito' | 'azure' | 'local')
VITE_AUTH_PROVIDER=cognito

# Configuración Amazon Cognito (AWS Academy Learner Lab - us-east-1)
VITE_AWS_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_lkheaHXdI
VITE_COGNITO_CLIENT_ID=28acj6aedtj69hjhbmr5lej5a6
VITE_COGNITO_DOMAIN=sgaob-auth-example

